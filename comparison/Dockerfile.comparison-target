# Minimal comparison-target image (fastapi + uvicorn baked in).
# Build: docker build -t ait-comparison-target:local -f Dockerfile.comparison-target .
FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir fastapi==0.115.6 uvicorn==0.34.0
# Application code is bind-mounted read-only at runtime.
CMD ["python", "-m", "uvicorn", "target_app:app", "--host", "0.0.0.0", "--port", "8080"]
